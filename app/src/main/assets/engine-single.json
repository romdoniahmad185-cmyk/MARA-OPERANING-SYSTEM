/* =====================================================
   MARA OS — UPGRADE ENGINE
   Prototype v1
   Storage : IndexedDB
   Native Android : BELUM DIGUNAKAN
===================================================== */

"use strict";


window.MARAUpgradeEngine = {

    /* =================================================
       CONFIGURATION
    ================================================= */

    config: {

        manifestURL:
            "https://romdoniahmad185-cmyk.github.io/mara-os-updates/stable/update-manifest.json",

        databaseName:
            "MARA_OS_STORAGE",

        databaseVersion:
            1,

        storeName:
            "builds",

        activeStoreName:
            "system",

        requestTimeout:
            30000

    },


    /* =================================================
       INTERNAL STATE
    ================================================= */

    state: {

        initialized: false,

        upgrading: false,

        activeBuild: null,

        remoteBuild: null,

        remoteVersion: null,

        progress: 0,

        status: "IDLE"

    },


    /* =================================================
       EVENT SYSTEM
    ================================================= */

    listeners: [],


    onStatus(callback) {

        if (
            typeof callback !==
            "function"
        ) {

            return () => {};

        }


        this.listeners.push(
            callback
        );


        return () => {

            this.listeners =
                this.listeners.filter(
                    listener =>
                        listener !== callback
                );

        };

    },


    emitStatus(data) {

        const payload = {

            ...data,

            timestamp:
                Date.now()

        };


        console.log(
            "[MARA UPGRADE]",
            payload
        );


        this.listeners.forEach(
            callback => {

                try {

                    callback(
                        payload
                    );

                } catch (error) {

                    console.error(
                        "[MARA UPGRADE] Status listener error:",
                        error
                    );

                }

            }
        );

    },


    /* =================================================
       STATUS HELPER
    ================================================= */

    setStatus(
        status,
        message,
        progress = null
    ) {

        this.state.status =
            status;


        if (
            progress !== null
        ) {

            this.state.progress =
                progress;

        }


        this.emitStatus({

            status,

            message,

            progress:
                this.state.progress

        });

    },


    /* =================================================
       OPEN DATABASE
    ================================================= */

    openDatabase() {

        return new Promise(
            (
                resolve,
                reject
            ) => {

                const request =
                    indexedDB.open(
                        this.config.databaseName,
                        this.config.databaseVersion
                    );


                request.onupgradeneeded =
                    event => {

                        const db =
                            event.target.result;


                        /* =================================
                           BUILD STORE
                        ================================= */

                        if (
                            !db.objectStoreNames.contains(
                                this.config.storeName
                            )
                        ) {

                            const buildStore =
                                db.createObjectStore(
                                    this.config.storeName,
                                    {
                                        keyPath:
                                            "build"
                                    }
                                );


                            buildStore.createIndex(
                                "version",
                                "version",
                                {
                                    unique:
                                        false
                                }
                            );


                            buildStore.createIndex(
                                "installedAt",
                                "installedAt",
                                {
                                    unique:
                                        false
                                }
                            );

                        }


                        /* =================================
                           SYSTEM STORE
                        ================================= */

                        if (
                            !db.objectStoreNames.contains(
                                this.config.activeStoreName
                            )
                        ) {

                            db.createObjectStore(
                                this.config.activeStoreName,
                                {
                                    keyPath:
                                        "key"
                                }
                            );

                        }

                    };


                request.onsuccess =
                    event => {

                        const db =
                            event.target.result;


                        db.onversionchange =
                            () => {

                                db.close();

                            };


                        this.state.initialized =
                            true;


                        resolve(
                            db
                        );

                    };


                request.onerror =
                    () => {

                        reject(
                            new Error(
                                "IndexedDB gagal dibuka."
                            )
                        );

                    };

            }
        );

    },


    /* =================================================
       DATABASE
    ================================================= */

    async getDatabase() {

        if (
            !this.state.initialized
        ) {

            return await this.openDatabase();

        }


        return await this.openDatabase();

    },


    /* =================================================
       GET ACTIVE BUILD
    ================================================= */

    async getActiveBuild() {

        const db =
            await this.getDatabase();


        return new Promise(
            (
                resolve,
                reject
            ) => {

                const transaction =
                    db.transaction(
                        this.config.activeStoreName,
                        "readonly"
                    );


                const store =
                    transaction.objectStore(
                        this.config.activeStoreName
                    );


                const request =
                    store.get(
                        "active-build"
                    );


                request.onsuccess =
                    () => {

                        resolve(
                            request.result ||
                            null
                        );

                    };


                request.onerror =
                    () => {

                        reject(
                            new Error(
                                "Gagal membaca active build."
                            )
                        );

                    };

            }
        );

    },


    /* =================================================
       SET ACTIVE BUILD
    ================================================= */

    async setActiveBuild(
        buildData
    ) {

        const db =
            await this.getDatabase();


        return new Promise(
            (
                resolve,
                reject
            ) => {

                const transaction =
                    db.transaction(
                        this.config.activeStoreName,
                        "readwrite"
                    );


                const store =
                    transaction.objectStore(
                        this.config.activeStoreName
                    );


                const request =
                    store.put({

                        key:
                            "active-build",

                        build:
                            buildData.build,

                        version:
                            buildData.version,

                        activatedAt:
                            Date.now()

                    });


                request.onsuccess =
                    () => {

                        resolve(
                            true
                        );

                    };


                request.onerror =
                    () => {

                        reject(
                            new Error(
                                "Gagal mengaktifkan build."
                            )
                        );

                    };

            }
        );

    },


    /* =================================================
       SAVE BUILD
    ================================================= */

    async saveBuild(
        buildData
    ) {

        const db =
            await this.getDatabase();


        return new Promise(
            (
                resolve,
                reject
            ) => {

                const transaction =
                    db.transaction(
                        this.config.storeName,
                        "readwrite"
                    );


                const store =
                    transaction.objectStore(
                        this.config.storeName
                    );


                const request =
                    store.put(
                        buildData
                    );


                request.onsuccess =
                    () => {

                        resolve(
                            true
                        );

                    };


                request.onerror =
                    () => {

                        reject(
                            new Error(
                                "Gagal menyimpan build."
                            )
                        );

                    };

            }
        );

    },


    /* =================================================
       GET BUILD
    ================================================= */

    async getBuild(
        buildNumber
    ) {

        const db =
            await this.getDatabase();


        return new Promise(
            (
                resolve,
                reject
            ) => {

                const transaction =
                    db.transaction(
                        this.config.storeName,
                        "readonly"
                    );


                const store =
                    transaction.objectStore(
                        this.config.storeName
                    );


                const request =
                    store.get(
                        Number(
                            buildNumber
                        )
                    );


                request.onsuccess =
                    () => {

                        resolve(
                            request.result ||
                            null
                        );

                    };


                request.onerror =
                    () => {

                        reject(
                            new Error(
                                "Gagal membaca build."
                            )
                        );

                    };

            }
        );

    },


    /* =================================================
       DELETE BUILD
    ================================================= */

    async deleteBuild(
        buildNumber
    ) {

        const db =
            await this.getDatabase();


        return new Promise(
            (
                resolve,
                reject
            ) => {

                const transaction =
                    db.transaction(
                        this.config.storeName,
                        "readwrite"
                    );


                const store =
                    transaction.objectStore(
                        this.config.storeName
                    );


                const request =
                    store.delete(
                        Number(
                            buildNumber
                        )
                    );


                request.onsuccess =
                    () => {

                        resolve(
                            true
                        );

                    };


                request.onerror =
                    () => {

                        reject(
                            new Error(
                                "Gagal menghapus build lama."
                            )
                        );

                    };

            }
        );

    },


    /* =================================================
       LIST BUILDS
    ================================================= */

    async getAllBuilds() {

        const db =
            await this.getDatabase();


        return new Promise(
            (
                resolve,
                reject
            ) => {

                const transaction =
                    db.transaction(
                        this.config.storeName,
                        "readonly"
                    );


                const store =
                    transaction.objectStore(
                        this.config.storeName
                    );


                const request =
                    store.getAll();


                request.onsuccess =
                    () => {

                        resolve(
                            request.result ||
                            []
                        );

                    };


                request.onerror =
                    () => {

                        reject(
                            new Error(
                                "Gagal membaca daftar build."
                            )
                        );

                    };

            }
        );

    },


    /* =================================================
       FETCH JSON
    ================================================= */

    async fetchJSON(
        url
    ) {

        const controller =
            new AbortController();


        const timeout =
            setTimeout(
                () => {

                    controller.abort();

                },
                this.config.requestTimeout
            );


        try {

            const response =
                await fetch(
                    url,
                    {
                        cache:
                            "no-store",

                        signal:
                            controller.signal
                    }
                );


            if (
                !response.ok
            ) {

                throw new Error(
                    `HTTP ${response.status}`
                );

            }


            return await response.json();

        } finally {

            clearTimeout(
                timeout
            );

        }

    },


    /* =================================================
       FETCH TEXT
    ================================================= */

    async fetchText(
        url,
        onProgress = null
    ) {

        const controller =
            new AbortController();


        const timeout =
            setTimeout(
                () => {

                    controller.abort();

                },
                this.config.requestTimeout
            );


        try {

            const response =
                await fetch(
                    url,
                    {
                        cache:
                            "no-store",

                        signal:
                            controller.signal
                    }
                );


            if (
                !response.ok
            ) {

                throw new Error(
                    `HTTP ${response.status}`
                );

            }


            /* =========================================
               STREAM DOWNLOAD
            ========================================= */

            if (
                !response.body
            ) {

                const text =
                    await response.text();


                if (
                    onProgress
                ) {

                    onProgress(
                        100
                    );

                }


                return text;

            }


            const reader =
                response.body.getReader();


            const contentLength =
                Number(
                    response.headers.get(
                        "Content-Length"
                    ) || 0
                );


            const chunks = [];

            let received =
                0;


            while (true) {

                const {
                    done,
                    value
                } =
                    await reader.read();


                if (done) {

                    break;

                }


                chunks.push(
                    value
                );


                received +=
                    value.length;


                if (
                    contentLength &&
                    onProgress
                ) {

                    const progress =
                        Math.min(
                            100,
                            Math.round(
                                (
                                    received /
                                    contentLength
                                ) * 100
                            )
                        );


                    onProgress(
                        progress
                    );

                }

            }


            const totalLength =
                chunks.reduce(
                    (
                        total,
                        chunk
                    ) =>
                        total +
                        chunk.length,
                    0
                );


            const combined =
                new Uint8Array(
                    totalLength
                );


            let offset =
                0;


            for (
                const chunk of chunks
            ) {

                combined.set(
                    chunk,
                    offset
                );


                offset +=
                    chunk.length;

            }


            const decoder =
                new TextDecoder(
                    "utf-8"
                );


            if (
                onProgress
            ) {

                onProgress(
                    100
                );

            }


            return decoder.decode(
                combined
            );

