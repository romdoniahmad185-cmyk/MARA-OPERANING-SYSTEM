"use strict";

const CACHE_NAME = "mara-os-v1";

self.addEventListener("install", event => {

    console.log("MARA Service Worker: INSTALL");

    self.skipWaiting();

});


self.addEventListener("activate", event => {

    console.log("MARA Service Worker: ACTIVATE");

    event.waitUntil(
        self.clients.claim()
    );

});


self.addEventListener("fetch", event => {

    if (event.request.method !== "GET") {
        return;
    }

    event.respondWith(
        fetch(event.request)
    );

});